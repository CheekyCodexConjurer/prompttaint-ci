{
  "name": "prompttaint",
  "version": "0.1.0",
  "description": "CI guardrail that finds prompt-injection paths in agentic GitHub workflows",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "prompttaint": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build && npm run scan:self",
    "scan:self": "node dist/cli.js scan --path . --format markdown --fail-on high",
    "agent:status": "node scripts/agent-status.mjs",
    "agent:commit": "node scripts/agent-safe-commit.mjs"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
