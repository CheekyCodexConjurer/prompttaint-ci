{
  "name": "prompttaint",
  "version": "0.1.0",
  "description": "Heuristic CI guardrail that detects risky prompt-injection patterns in agentic GitHub workflows",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "prompttaint": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "action.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CheekyCodexConjurer/prompttaint-ci.git"
  },
  "bugs": {
    "url": "https://github.com/CheekyCodexConjurer/prompttaint-ci/issues"
  },
  "homepage": "https://github.com/CheekyCodexConjurer/prompttaint-ci#readme",
  "keywords": [
    "prompt-injection",
    "ai-agents",
    "codex",
    "claude-code",
    "cursor",
    "github-actions",
    "security",
    "static-analysis"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "validate": "npm run check:claims && npm run lint && npm run typecheck && npm run build && npm run test && npm run scan:self",
    "validate:release": "npm run validate && npm run pack:dry-run && npm run smoke:packed",
    "prepublishOnly": "npm run validate:release",
    "pack:dry-run": "npm pack --dry-run",
    "smoke:packed": "node scripts/smoke-packed.mjs",
    "scan:self": "node dist/cli.js scan --path . --format markdown --fail-on high",
    "check:claims": "node scripts/docs-claim-check.mjs",
    "agent:status": "node scripts/agent-status.mjs",
    "agent:commit": "node scripts/agent-safe-commit.mjs"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
